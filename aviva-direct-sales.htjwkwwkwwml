<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Direct Sales Executive — Aviva Nirmaan Program | CareerNext Academy</title>
<meta name="description" content="Aviva Nirmaan Program with Aviva India: join as Direct Sales Executive. 3-Month Program, placement assistance, ₹3.5 LPA + variable pay.">
<style>/* =========================================================
   CareerNext Academy — shared stylesheet
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap');

:root{
  --bg:            #0a070a;
  --bg-alt:        #130a10;
  --card:          #17101a;
  --card-2:        #1c1219;
  --border:        rgba(255,255,255,.09);
  --pink:          #e0184f;
  --pink-2:        #ff4d80;
  --pink-deep:     #8f0f38;
  --gold:          #d8ad4d;
  --text:          #f4eef1;
  --muted:         #b9aab1;
  --muted-2:       #8a7a81;
  --radius:        14px;
  --maxw:          1240px;
  --ease:          cubic-bezier(.22,1,.36,1);
}

*,*::before,*::after{box-sizing:border-box;}
svg{flex-shrink:0;}
.btn svg,.apply-btn svg,.wa-float svg,.know svg,.viewall svg,.faq-item svg,.prog-tags svg{width:16px;height:16px;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:'Manrope',sans-serif;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,h4{
  font-family:'Sora',sans-serif;
  margin:0;
  line-height:1.15;
  letter-spacing:-.01em;
}
p{margin:0;}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}
ul{margin:0;padding:0;list-style:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}

@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important;scroll-behavior:auto !important;}
}

/* ---------- background texture ---------- */
body::before{
  content:"";
  position:fixed;inset:0;
  background:
    radial-gradient(700px 500px at 85% -5%, rgba(224,24,79,.16), transparent 60%),
    radial-gradient(600px 500px at -5% 15%, rgba(224,24,79,.10), transparent 55%);
  pointer-events:none;
  z-index:0;
}

/* =========================================================
   Header
   ========================================================= */
header.site{
  position:sticky;top:0;z-index:100;
  background:rgba(9,6,9,.97);
  border-bottom:1px solid var(--border);
}
.nav{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 24px;
}
.logo{display:flex;align-items:center;gap:10px;}
.logo .mark{width:38px;height:38px;flex:none;}
.logo .word{font-family:'Sora',sans-serif;font-weight:800;font-size:1.18rem;letter-spacing:-.01em;}
.logo .word small{display:block;font-family:'Manrope',sans-serif;font-weight:600;font-size:.56rem;letter-spacing:.22em;color:var(--muted);margin-top:1px;}
.logo .word .next{color:var(--pink-2);}

.navlinks{display:flex;align-items:center;gap:30px;}
.navlinks a{
  font-size:.92rem;font-weight:600;color:var(--muted);
  position:relative;padding:6px 0;
  transition:color .25s var(--ease);
}
.navlinks a::after{
  content:"";position:absolute;left:0;bottom:0;height:2px;width:0;
  background:linear-gradient(90deg,var(--pink),var(--pink-2));
  transition:width .32s var(--ease);
  border-radius:2px;
}
.navlinks a:hover{color:var(--text);}
.navlinks a:hover::after,.navlinks a.active::after{width:100%;}
.navlinks a.active{color:var(--text);}

.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 22px;border-radius:999px;
  font-weight:700;font-size:.9rem;
  transition:transform .3s var(--ease),box-shadow .3s var(--ease),background .3s var(--ease);
  white-space:nowrap;
}
.btn-primary{
  background:linear-gradient(135deg,var(--pink),var(--pink-deep));
  color:#fff;
  box-shadow:0 8px 24px -8px rgba(224,24,79,.65);
  position:relative;overflow:hidden;
}
.btn-primary::before{
  content:"";position:absolute;inset:0;
  background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.35) 45%,transparent 60%);
  transform:translateX(-120%);
}
.btn-primary:hover::before{transform:translateX(120%);transition:transform .8s var(--ease);}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 30px -8px rgba(224,24,79,.8);}
.btn-ghost{
  background:rgba(255,255,255,.04);
  border:1px solid var(--border);
  color:var(--text);
}
.btn-ghost:hover{background:rgba(255,255,255,.09);transform:translateY(-2px);}
.btn-block{width:100%;justify-content:center;}

.nav-cta{display:flex;align-items:center;gap:14px;}
.burger{display:none;}

/* =========================================================
   Hero
   ========================================================= */
.hero{position:relative;padding:76px 0 60px;overflow:hidden;}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center;}

.badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:8px 16px;border-radius:999px;
  background:rgba(224,24,79,.12);
  border:1px solid rgba(224,24,79,.35);
  font-size:.78rem;font-weight:700;color:var(--pink-2);
  opacity:0;animation:dropIn .7s var(--ease) .1s forwards;
}
.badge .dot{width:6px;height:6px;border-radius:50%;background:var(--pink-2);box-shadow:0 0 0 4px rgba(224,24,79,.25);}

.hero h1{
  font-size:clamp(2.3rem,4.6vw,3.6rem);
  font-weight:800;margin:18px 0 16px;
}
.hero h1 .line{display:block;overflow:hidden;}
.hero h1 .line span{
  display:inline-block;
  transform:translateY(115%);
  animation:riseUp .8s var(--ease) forwards;
}
.hero h1 .line:nth-child(1) span{animation-delay:.22s;}
.hero h1 .line:nth-child(2) span{animation-delay:.36s;color:var(--pink-2);}

.hero p.lead{
  color:var(--muted);font-size:1.04rem;max-width:480px;margin-bottom:28px;
  opacity:0;animation:dropIn .7s var(--ease) .55s forwards;
}
.hero .cta-row{display:flex;gap:14px;margin-bottom:34px;flex-wrap:wrap;
  opacity:0;animation:dropIn .7s var(--ease) .7s forwards;}

.hero-stats{display:flex;gap:34px;flex-wrap:wrap;
  opacity:0;animation:dropIn .7s var(--ease) .85s forwards;}
.hero-stats .stat b{
  display:block;font-family:'Sora',sans-serif;font-size:1.5rem;font-weight:800;color:var(--text);
}
.hero-stats .stat span{font-size:.8rem;color:var(--muted);}

.hero-visual{position:relative;height:460px;}
.hero-visual .glow{
  position:absolute;inset:6%;
  border-radius:50%;
  background:radial-gradient(circle at 50% 35%,rgba(224,24,79,.55),rgba(224,24,79,.08) 60%,transparent 72%);
  filter:blur(6px);
  animation:pulseGlow 4.5s ease-in-out infinite;
}
.hero-visual .ring{
  position:absolute;inset:0;border-radius:50%;
  border:1px dashed rgba(224,24,79,.35);
  animation:spinSlow 40s linear infinite;
}
.hero-visual .ring.r2{inset:8%;border-color:rgba(216,173,77,.3);animation-duration:60s;animation-direction:reverse;}
.hero-visual .core{
  position:absolute;inset:18%;border-radius:28px;
  background:linear-gradient(155deg,#1c1219,#0f0810 70%);
  border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 30px 60px -20px rgba(0,0,0,.7);
  animation:floatY 5s ease-in-out infinite;
}
.hero-visual .core svg{width:56%;height:56%;}

.side-chips{position:absolute;right:-6px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:12px;}
.chip{
  display:flex;align-items:center;gap:12px;
  background:rgba(23,16,26,.9);border:1px solid var(--border);
  padding:11px 16px;border-radius:12px;min-width:190px;
  backdrop-filter:blur(6px);
  opacity:0;transform:translateX(30px);
  animation:slideChip .6s var(--ease) forwards;
}
.chip:nth-child(1){animation-delay:1s;}
.chip:nth-child(2){animation-delay:1.15s;}
.chip:nth-child(3){animation-delay:1.3s;}
.chip:nth-child(4){animation-delay:1.45s;}
.chip .ic{
  width:34px;height:34px;border-radius:9px;flex:none;
  background:rgba(224,24,79,.16);
  display:flex;align-items:center;justify-content:center;color:var(--pink-2);
}
.chip b{display:block;font-size:.82rem;}
.chip span{font-size:.72rem;color:var(--muted);}

@media (max-width:1000px){
  .side-chips{display:none;}
}

/* =========================================================
   Section headers
   ========================================================= */
.section{padding:70px 0;position:relative;}
.section-head{
  display:flex;align-items:flex-end;justify-content:space-between;
  margin-bottom:34px;gap:20px;flex-wrap:wrap;
}
.section-head h2{font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:800;}
.section-head .viewall{
  font-size:.86rem;font-weight:700;color:var(--pink-2);
  display:flex;align-items:center;gap:6px;
}
.section-head .viewall svg{transition:transform .3s var(--ease);}
.section-head .viewall:hover svg{transform:translate(4px,-4px);}

.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s var(--ease),transform .7s var(--ease);}
.reveal.in{opacity:1;transform:translateY(0);}

/* =========================================================
   Program cards (grid 1 — slide/scale from alternating sides)
   ========================================================= */
.grid-programs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.pcard{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:22px;display:flex;flex-direction:column;gap:14px;
  transition:transform .45s var(--ease),border-color .45s var(--ease),box-shadow .45s var(--ease);
  opacity:0;transform:translateY(34px) scale(.96);
}
.pcard.in{opacity:1;transform:translateY(0) scale(1);transition-delay:var(--d,0s);}
.pcard:hover{transform:translateY(-8px);border-color:rgba(224,24,79,.4);box-shadow:0 20px 40px -18px rgba(224,24,79,.35);}
.pcard .icon-badge{
  width:56px;height:56px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  background:var(--card-2);border:1px solid var(--border);
  font-size:1.5rem;font-weight:800;color:var(--pink-2);
}
.pcard h3{font-size:1.05rem;font-weight:700;}
.pcard .meta{font-size:.82rem;color:var(--muted);display:flex;flex-direction:column;gap:5px;}
.pcard .meta li{display:flex;align-items:center;gap:7px;}
.pcard .meta svg{flex:none;color:var(--pink-2);}
.pcard .know{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  padding:10px 16px;border-radius:999px;border:1px solid var(--border);
  font-size:.84rem;font-weight:700;
  transition:background .3s var(--ease),border-color .3s var(--ease);
}
.pcard .know:hover{background:rgba(224,24,79,.14);border-color:rgba(224,24,79,.4);}
.pcard .know svg{transition:transform .3s var(--ease);}
.pcard .know:hover svg{transform:translate(3px,-3px);}

@media(max-width:920px){.grid-programs{grid-template-columns:repeat(2,1fr);}}
@media(max-width:620px){.grid-programs{grid-template-columns:1fr;}}

/* =========================================================
   Why choose (grid 2 — pop / bounce in)
   ========================================================= */
.why-band{
  background:linear-gradient(180deg,var(--bg-alt),var(--bg));
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.why-head{text-align:center;max-width:560px;margin:0 auto 44px;}
.why-head h2{font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:800;margin-bottom:10px;}
.why-head p{color:var(--muted);}
.why-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;}
.why-item{text-align:center;opacity:0;transform:scale(.6);}
.why-item.in{
  animation:popBounce .7s var(--ease) forwards;
  animation-delay:var(--d,0s);
}
.why-item .circ{
  width:64px;height:64px;margin:0 auto 14px;border-radius:50%;
  background:rgba(224,24,79,.12);border:1px solid rgba(224,24,79,.3);
  display:flex;align-items:center;justify-content:center;color:var(--pink-2);
  transition:transform .35s var(--ease),background .35s var(--ease);
}
.why-item:hover .circ{transform:rotate(-8deg) scale(1.08);background:rgba(224,24,79,.22);}
.why-item h4{font-size:.92rem;font-weight:700;margin-bottom:6px;}
.why-item p{font-size:.76rem;color:var(--muted);}

@media(max-width:980px){.why-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:560px){.why-grid{grid-template-columns:repeat(2,1fr);}}

/* =========================================================
   Journey timeline (grid 3 — draw line + rise)
   ========================================================= */
.journey-head{text-align:center;max-width:520px;margin:0 auto 46px;}
.journey-head h2{font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:800;margin-bottom:8px;}
.journey-head p{color:var(--muted);}
.timeline{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.timeline::before{
  content:"";position:absolute;top:26px;left:6%;right:6%;height:2px;
  background:linear-gradient(90deg,var(--pink) 0%,var(--pink) var(--p,0%),rgba(255,255,255,.09) var(--p,0%));
  transition:--p 1.4s var(--ease);
  z-index:0;
}
.tl-item{
  position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:26px 22px;opacity:0;transform:translateY(24px);
}
.tl-item.in{animation:riseFade .7s var(--ease) forwards;animation-delay:var(--d,0s);}
.tl-item .yr{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(224,24,79,.15);color:var(--pink-2);
  font-weight:800;font-size:.85rem;padding:6px 14px;border-radius:999px;margin-bottom:14px;
}
.tl-item h4{font-size:1.02rem;font-weight:700;margin-bottom:8px;}
.tl-item p{font-size:.85rem;color:var(--muted);}
.tl-item .glyph{
  position:absolute;right:18px;bottom:16px;color:rgba(224,24,79,.35);
}
.tl-item .glyph svg{width:34px;height:34px;}

@media(max-width:820px){.timeline{grid-template-columns:1fr;}.timeline::before{display:none;}}

/* =========================================================
   CTA banner
   ========================================================= */
.cta-banner{
  border-radius:24px;overflow:hidden;position:relative;
  background:linear-gradient(120deg,var(--pink-deep),var(--pink) 60%,#3a0d1e);
  padding:52px 40px;display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;
}
.cta-banner::after{
  content:"";position:absolute;inset:0;
  background:radial-gradient(300px 220px at 85% 20%,rgba(255,255,255,.18),transparent 60%);
}
.cta-banner h2{font-size:clamp(1.5rem,2.6vw,2rem);font-weight:800;margin-bottom:8px;}
.cta-banner p{color:rgba(255,255,255,.85);max-width:420px;}
.cta-banner .btn-ghost{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3);}
.cta-banner .btn-ghost:hover{background:rgba(255,255,255,.24);}
.cta-left{position:relative;z-index:1;}
.cta-right{position:relative;z-index:1;}

/* =========================================================
   Footer
   ========================================================= */
footer.site{border-top:1px solid var(--border);padding:56px 0 20px;background:var(--bg-alt);}
.foot-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1.3fr;gap:36px;margin-bottom:40px;}
.foot-grid h5{font-size:.98rem;font-weight:700;margin-bottom:16px;}
.foot-grid p{font-size:.85rem;color:var(--muted);margin-bottom:14px;}
.foot-links li{margin-bottom:10px;}
.foot-links a{font-size:.86rem;color:var(--muted);transition:color .25s,padding-left .25s;}
.foot-links a:hover{color:var(--pink-2);padding-left:4px;}
.foot-contact li{display:flex;gap:10px;align-items:flex-start;font-size:.85rem;color:var(--muted);margin-bottom:12px;}
.foot-contact svg{flex:none;color:var(--pink-2);margin-top:2px;}
.social{display:flex;gap:10px;margin-top:16px;}
.social a{
  width:34px;height:34px;border-radius:9px;background:var(--card);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;transition:all .3s var(--ease);
}
.social a:hover{background:var(--pink);transform:translateY(-3px);}

.faq-item{border-bottom:1px solid var(--border);}
.faq-item button{
  width:100%;display:flex;align-items:center;justify-content:space-between;
  padding:13px 0;font-size:.87rem;font-weight:600;text-align:left;
}
.faq-item button svg{transition:transform .35s var(--ease);flex:none;color:var(--pink-2);}
.faq-item.open button svg{transform:rotate(45deg);}
.faq-item .a{
  max-height:0;overflow:hidden;transition:max-height .4s var(--ease);
  font-size:.82rem;color:var(--muted);
}
.faq-item.open .a{max-height:120px;padding-bottom:14px;}

.foot-bottom{
  border-top:1px solid var(--border);padding-top:20px;
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;
  font-size:.78rem;color:var(--muted-2);
}
.foot-bottom a{color:var(--muted-2);}
.foot-bottom a:hover{color:var(--pink-2);}

@media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:560px){.foot-grid{grid-template-columns:1fr;}}

/* =========================================================
   WhatsApp floating button
   ========================================================= */
.wa-float{
  position:fixed;right:22px;bottom:22px;z-index:200;
  width:58px;height:58px;border-radius:50%;
  background:#25d366;color:#fff;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 10px 26px -6px rgba(37,211,102,.7);
  animation:floatBtn 3.2s ease-in-out infinite;
}
.wa-float::before{
  content:"";position:absolute;inset:0;border-radius:50%;
  background:#25d366;opacity:.55;
  animation:pingRing 2.2s ease-out infinite;
}
.wa-float svg{width:28px;height:28px;position:relative;z-index:1;}
.wa-float:hover{animation-play-state:paused;transform:scale(1.08);}

/* =========================================================
   Keyframes
   ========================================================= */
@keyframes riseUp{to{transform:translateY(0);}}
@keyframes dropIn{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:translateY(0);}}
@keyframes slideChip{to{opacity:1;transform:translateX(0);}}
@keyframes pulseGlow{0%,100%{opacity:.7;transform:scale(1);}50%{opacity:1;transform:scale(1.08);}}
@keyframes spinSlow{to{transform:rotate(360deg);}}
@keyframes floatY{0%,100%{transform:translateY(0);}50%{transform:translateY(-14px);}}
@keyframes popBounce{
  0%{opacity:0;transform:scale(.4);}
  60%{opacity:1;transform:scale(1.12);}
  100%{opacity:1;transform:scale(1);}
}
@keyframes riseFade{to{opacity:1;transform:translateY(0);}}
@keyframes floatBtn{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
@keyframes pingRing{0%{transform:scale(1);opacity:.55;}100%{transform:scale(1.9);opacity:0;}}
@keyframes countPulse{from{opacity:.3;}to{opacity:1;}}

/* =========================================================
   Mobile nav
   ========================================================= */
@media(max-width:960px){
  .navlinks{
    position:fixed;top:66px;left:0;right:0;bottom:0;
    background:#0a070a;flex-direction:column;align-items:flex-start;
    padding:26px 24px;gap:20px;
    transform:translateX(-100%);transition:transform .4s var(--ease);
    border-top:1px solid var(--border);
    z-index:150;
  }
  .navlinks.open{transform:translateX(0);}
  .burger{
    display:flex;flex-direction:column;gap:5px;width:26px;
  }
  .burger span{height:2px;background:var(--text);border-radius:2px;transition:all .3s var(--ease);}
  .nav-cta .btn-ghost{display:none;}
  .hero .wrap{grid-template-columns:1fr;}
  .hero-visual{height:320px;margin-top:10px;}
}
@media(max-width:480px){
  .nav{padding:12px 16px;}
  .nav-cta{gap:10px;}
  .nav-cta .btn-primary{padding:10px 16px;font-size:.8rem;}
  .logo .word{font-size:1rem;}
}

/* =========================================================
   Program detail page
   ========================================================= */
.breadcrumb{font-size:.82rem;color:var(--muted);padding:20px 0 0;display:flex;gap:8px;align-items:center;}
.breadcrumb a{color:var(--muted);}
.breadcrumb a:hover{color:var(--pink-2);}
.breadcrumb .sep{opacity:.5;}
.breadcrumb .cur{color:var(--text);font-weight:600;}

.prog-hero{padding:34px 0 60px;}
.prog-hero .wrap{display:grid;grid-template-columns:1fr .82fr;gap:46px;align-items:flex-start;}

.prog-tags{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
.prog-tags span{
  font-size:.72rem;font-weight:700;padding:6px 12px;border-radius:999px;
  background:rgba(224,24,79,.14);color:var(--pink-2);border:1px solid rgba(224,24,79,.3);
  display:flex;align-items:center;gap:6px;
}
.prog-hero h1{font-size:clamp(1.9rem,3.4vw,2.6rem);font-weight:800;margin-bottom:14px;
  opacity:0;animation:riseFade .7s var(--ease) .1s forwards;transform:translateY(20px);}
.prog-hero .sub{color:var(--muted);font-size:1.02rem;max-width:540px;margin-bottom:26px;
  opacity:0;animation:riseFade .7s var(--ease) .25s forwards;transform:translateY(20px);}

.stat-row{display:flex;gap:28px;flex-wrap:wrap;margin-bottom:34px;
  opacity:0;animation:riseFade .7s var(--ease) .4s forwards;transform:translateY(20px);}
.stat-row .s b{display:block;font-family:'Sora',sans-serif;font-size:1.35rem;font-weight:800;}
.stat-row .s span{font-size:.78rem;color:var(--muted);}

.about-block{margin-bottom:30px;}
.about-block h3{font-size:1.2rem;font-weight:700;margin-bottom:12px;}
.about-block p{color:var(--muted);margin-bottom:12px;font-size:.95rem;}

.highlight-list{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:10px;}
.highlight-list li{
  display:flex;gap:12px;align-items:flex-start;
  background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;
  font-size:.86rem;
  opacity:0;transform:translateX(-16px);
}
.highlight-list li.in{animation:slideRight .55s var(--ease) forwards;animation-delay:var(--d,0s);}
.highlight-list svg{flex:none;color:var(--pink-2);margin-top:2px;}
@keyframes slideRight{to{opacity:1;transform:translateX(0);}}
@media(max-width:600px){.highlight-list{grid-template-columns:1fr;}}

.stipend-box{
  background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;margin:22px 0;
}
.stipend-box h4{font-size:.95rem;font-weight:700;margin-bottom:12px;}
.stipend-box li{display:flex;justify-content:space-between;font-size:.85rem;color:var(--muted);padding:8px 0;border-bottom:1px dashed var(--border);}
.stipend-box li:last-child{border-bottom:none;}
.stipend-box li b{color:var(--text);}

/* sticky apply card (mirrors reference screenshot) */
.apply-card{
  position:sticky;top:100px;
  background:linear-gradient(160deg,var(--pink-deep),#4a0f26 75%);
  border:1px solid rgba(255,255,255,.12);
  border-radius:20px;padding:26px;
  box-shadow:0 30px 60px -24px rgba(224,24,79,.5);
  opacity:0;transform:translateY(26px) scale(.97);
  animation:cardIn .8s var(--ease) .3s forwards;
}
@keyframes cardIn{to{opacity:1;transform:translateY(0) scale(1);}}
.apply-card .logo-chip{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.12);padding:8px 14px;border-radius:10px;
  font-weight:700;font-size:.85rem;margin-bottom:16px;
}
.apply-card h3{font-size:1.3rem;font-weight:800;margin-bottom:8px;}
.apply-card .tag{font-size:.88rem;color:rgba(255,255,255,.82);margin-bottom:18px;}
.apply-card .ctc{
  background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.18);
  border-radius:12px;padding:14px 16px;font-weight:800;font-size:1.05rem;margin-bottom:18px;
}
.apply-card .ctc span{display:block;font-size:.7rem;font-weight:600;color:rgba(255,255,255,.7);margin-top:2px;}
.apply-card .field-row{display:flex;flex-direction:column;gap:10px;margin-bottom:16px;}
.apply-card input,.apply-card select{
  width:100%;padding:11px 14px;border-radius:9px;border:1px solid rgba(255,255,255,.2);
  background:rgba(255,255,255,.08);color:#fff;font-size:.86rem;
}
.apply-card input::placeholder{color:rgba(255,255,255,.55);}
.apply-card .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.apply-card .apply-btn{
  width:100%;padding:14px;border-radius:11px;background:#fff;color:var(--pink-deep);
  font-weight:800;font-size:.95rem;display:flex;align-items:center;justify-content:center;gap:8px;
  transition:transform .3s var(--ease),box-shadow .3s var(--ease);
}
.apply-card .apply-btn:hover{transform:translateY(-3px);box-shadow:0 14px 30px -10px rgba(0,0,0,.5);}
.apply-card .note{font-size:.7rem;color:rgba(255,255,255,.6);margin-top:12px;text-align:center;}

@media(max-width:960px){
  .prog-hero .wrap{grid-template-columns:1fr;}
  .apply-card{position:static;}
}

.eligi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:16px;}
.eligi-card{
  background:var(--card);border:1px solid var(--border);border-radius:14px;padding:22px;
  opacity:0;transform:translateY(20px) rotate(-2deg);
}
.eligi-card.in{animation:tiltIn .6s var(--ease) forwards;animation-delay:var(--d,0s);}
@keyframes tiltIn{to{opacity:1;transform:translateY(0) rotate(0);}}
.eligi-card .ic{
  width:46px;height:46px;border-radius:11px;background:rgba(224,24,79,.14);
  display:flex;align-items:center;justify-content:center;color:var(--pink-2);margin-bottom:14px;
}
.eligi-card h4{font-size:1rem;font-weight:700;margin-bottom:6px;}
.eligi-card p{font-size:.84rem;color:var(--muted);}
@media(max-width:760px){.eligi-grid{grid-template-columns:1fr;}}

.related-strip{display:flex;gap:16px;overflow-x:auto;padding-bottom:10px;}
.related-strip .rp{
  flex:none;width:230px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;
  transition:transform .3s var(--ease),border-color .3s var(--ease);
}
.related-strip .rp:hover{transform:translateY(-5px);border-color:rgba(224,24,79,.4);}
.related-strip .rp .ib{width:40px;height:40px;border-radius:9px;background:var(--card-2);display:flex;align-items:center;justify-content:center;color:var(--pink-2);font-weight:800;margin-bottom:10px;}
.related-strip .rp h5{font-size:.9rem;font-weight:700;margin-bottom:4px;}
.related-strip .rp span{font-size:.75rem;color:var(--muted);}

/* =========================================================
   Footer map
   ========================================================= */
.foot-map{
  margin-top:16px;border-radius:12px;overflow:hidden;border:1px solid var(--border);
  height:150px;filter:grayscale(.25) invert(.92) contrast(.9);
}
.foot-map iframe{width:100%;height:100%;border:0;display:block;}

/* =========================================================
   Partners marquee
   ========================================================= */
.partners-band{padding-bottom:50px;}
.marquee{overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);}
.marquee-track{display:flex;gap:16px;width:max-content;animation:marqueeScroll 26s linear infinite;}
.marquee:hover .marquee-track{animation-play-state:paused;}
.partner-chip{
  flex:none;padding:16px 28px;border-radius:12px;
  background:var(--card);border:1px solid var(--border);
  font-family:'Sora',sans-serif;font-weight:700;font-size:.95rem;color:var(--text);
  display:flex;align-items:center;gap:10px;white-space:nowrap;
  transition:transform .3s var(--ease),border-color .3s var(--ease);
}
.partner-chip::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--pink-2);box-shadow:0 0 0 4px rgba(224,24,79,.2);}
.partner-chip:hover{transform:translateY(-4px);border-color:rgba(224,24,79,.4);}
@keyframes marqueeScroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* =========================================================
   Apply Wizard
   ========================================================= */
.wizard-wrap{max-width:720px;margin:0 auto;padding:34px 24px 80px;}
.wizard-summary{
  background:linear-gradient(160deg,var(--pink-deep),#3a0d1e 80%);
  border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:22px 24px;margin-bottom:30px;
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;
  opacity:0;animation:riseFade .6s var(--ease) forwards;
}
.wizard-summary h2{font-size:1.15rem;font-weight:800;margin-bottom:4px;}
.wizard-summary p{color:rgba(255,255,255,.8);font-size:.85rem;}
.wizard-summary .figs{display:flex;gap:22px;flex-wrap:wrap;}
.wizard-summary .figs div b{display:block;font-family:'Sora',sans-serif;font-weight:800;font-size:1.05rem;}
.wizard-summary .figs div span{font-size:.72rem;color:rgba(255,255,255,.75);}

.steps-bar{display:flex;align-items:center;margin-bottom:34px;gap:0;}
.steps-bar .step{flex:1;text-align:center;position:relative;}
.steps-bar .step .dot{
  width:32px;height:32px;border-radius:50%;background:var(--card);border:2px solid var(--border);
  display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-weight:800;font-size:.82rem;
  transition:all .35s var(--ease);position:relative;z-index:2;color:var(--muted);
}
.steps-bar .step span.lbl{font-size:.72rem;color:var(--muted);font-weight:600;}
.steps-bar .step::before{
  content:"";position:absolute;top:16px;left:-50%;width:100%;height:2px;background:var(--border);z-index:1;
}
.steps-bar .step:first-child::before{display:none;}
.steps-bar .step.active .dot,.steps-bar .step.done .dot{background:var(--pink);border-color:var(--pink);color:#fff;}
.steps-bar .step.active span.lbl,.steps-bar .step.done span.lbl{color:var(--text);}
.steps-bar .step.done::before{background:var(--pink);}

.wizard-card{
  background:var(--card);border:1px solid var(--border);border-radius:18px;padding:28px;
  opacity:0;transform:translateY(16px);animation:riseFade .5s var(--ease) forwards;
}
.wizard-card h3{font-size:1.2rem;font-weight:800;margin-bottom:6px;}
.wizard-card .hint{color:var(--muted);font-size:.86rem;margin-bottom:22px;}
.f-group{margin-bottom:16px;}
.f-group label{display:block;font-size:.82rem;font-weight:700;margin-bottom:7px;color:var(--muted);}
.f-group input,.f-group select,.f-group textarea{
  width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--border);
  background:var(--card-2);color:var(--text);font-size:.9rem;font-family:inherit;
}
.f-group textarea{resize:vertical;min-height:80px;}
.f-row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:560px){.f-row2{grid-template-columns:1fr;}}

.otp-box{
  background:rgba(224,24,79,.1);border:1px dashed rgba(224,24,79,.4);border-radius:12px;
  padding:16px;text-align:center;margin-bottom:20px;
}
.otp-box .code{font-family:'Sora',sans-serif;font-size:1.8rem;font-weight:800;letter-spacing:.3em;color:var(--pink-2);margin:6px 0;}
.otp-box small{color:var(--muted);font-size:.74rem;}
.otp-inputs{display:flex;gap:10px;justify-content:center;margin-bottom:16px;}
.otp-inputs input{
  width:52px;height:56px;text-align:center;font-size:1.3rem;font-weight:800;
  border-radius:10px;border:1px solid var(--border);background:var(--card-2);color:var(--text);
}
.otp-inputs input.err{border-color:#ff5c7a;animation:shake .4s;}
@keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-6px);}75%{transform:translateX(6px);}}
.otp-msg{text-align:center;font-size:.82rem;margin-bottom:14px;min-height:18px;}
.otp-msg.err{color:#ff7a90;}
.otp-msg.ok{color:#4ade80;}
.resend{display:block;text-align:center;font-size:.8rem;color:var(--pink-2);font-weight:700;margin-top:6px;}

.pay-options{display:flex;flex-direction:column;gap:12px;margin-bottom:20px;}
.pay-opt{
  display:flex;justify-content:space-between;align-items:center;gap:14px;
  border:1px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;
  transition:border-color .25s,background .25s;
}
.pay-opt.sel{border-color:var(--pink);background:rgba(224,24,79,.1);}
.pay-opt b{display:block;font-size:.92rem;}
.pay-opt span{font-size:.78rem;color:var(--muted);}
.pay-opt .amt{font-family:'Sora',sans-serif;font-weight:800;font-size:1.05rem;color:var(--pink-2);}

.wizard-actions{display:flex;justify-content:space-between;gap:12px;margin-top:24px;}
.wizard-actions .btn-ghost{flex:none;}
.wizard-actions .btn-primary{flex:1;}

.success-panel{text-align:center;padding:10px 0;}
.success-panel .tick{
  width:72px;height:72px;border-radius:50%;background:rgba(74,222,128,.15);border:2px solid #4ade80;
  display:flex;align-items:center;justify-content:center;margin:0 auto 18px;color:#4ade80;
  animation:popBounce .6s var(--ease) forwards;
}
.success-panel h3{font-size:1.3rem;font-weight:800;margin-bottom:8px;}
.success-panel p{color:var(--muted);font-size:.9rem;margin-bottom:6px;}
.ref-box{
  display:inline-block;background:var(--card-2);border:1px dashed var(--border);border-radius:10px;
  padding:10px 18px;font-family:'Sora',sans-serif;font-weight:800;letter-spacing:.05em;margin:14px 0;
}

/* =========================================================
   Admin dashboard
   ========================================================= */
.admin-login-wrap{max-width:400px;margin:70px auto;padding:0 24px;}
.admin-card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:30px;text-align:center;}
.admin-card .lock{
  width:60px;height:60px;border-radius:50%;background:rgba(224,24,79,.14);color:var(--pink-2);
  display:flex;align-items:center;justify-content:center;margin:0 auto 16px;
}
.admin-card h2{font-size:1.2rem;font-weight:800;margin-bottom:6px;}
.admin-card p{color:var(--muted);font-size:.85rem;margin-bottom:20px;}
.admin-card input{
  width:100%;padding:13px 14px;border-radius:10px;border:1px solid var(--border);
  background:var(--card-2);color:var(--text);font-size:.9rem;margin-bottom:14px;text-align:center;
  letter-spacing:.08em;
}
.admin-err{color:#ff7a90;font-size:.82rem;margin-bottom:10px;min-height:18px;}

.admin-wrap{max-width:1240px;margin:0 auto;padding:28px 24px 80px;}
.admin-top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:26px;}
.admin-top h1{font-size:1.4rem;font-weight:800;}
.admin-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:26px;}
.admin-stats .st{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px;}
.admin-stats .st b{display:block;font-family:'Sora',sans-serif;font-size:1.5rem;font-weight:800;}
.admin-stats .st span{font-size:.76rem;color:var(--muted);}
.admin-stats .st.warn b{color:#f5a524;}
@media(max-width:900px){.admin-stats{grid-template-columns:repeat(2,1fr);}}

.admin-toolbar{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;align-items:center;justify-content:space-between;}
.admin-toolbar input[type=text]{
  padding:10px 14px;border-radius:10px;border:1px solid var(--border);background:var(--card-2);
  color:var(--text);font-size:.85rem;min-width:220px;
}
.table-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:14px;}
table.admin-table{width:100%;border-collapse:collapse;font-size:.82rem;min-width:900px;}
table.admin-table th{
  text-align:left;padding:12px 14px;background:var(--card-2);color:var(--muted);
  font-weight:700;font-size:.74rem;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;
}
table.admin-table td{padding:12px 14px;border-top:1px solid var(--border);vertical-align:top;white-space:nowrap;}
table.admin-table tr.row-warn td{background:rgba(245,165,36,.08);}
table.admin-table tr.row-ok td{background:rgba(74,222,128,.05);}
.pill{display:inline-block;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:700;}
.pill.p1{background:rgba(245,165,36,.18);color:#f5a524;}
.pill.p2{background:rgba(96,165,250,.18);color:#60a5fa;}
.pill.p3{background:rgba(224,24,79,.18);color:var(--pink-2);}
.pill.p4{background:rgba(74,222,128,.18);color:#4ade80;}
.viewbtn{font-size:.76rem;font-weight:700;color:var(--pink-2);cursor:pointer;}
.admin-empty{padding:50px 20px;text-align:center;color:var(--muted);}

.modal-bg{
  position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:300;
  display:none;align-items:center;justify-content:center;padding:20px;
}
.modal-bg.open{display:flex;}
.modal-box{
  background:var(--card);border:1px solid var(--border);border-radius:16px;padding:26px;
  max-width:520px;width:100%;max-height:85vh;overflow-y:auto;
}
.modal-box h3{font-size:1.1rem;font-weight:800;margin-bottom:14px;}
.modal-box dl{display:grid;grid-template-columns:110px 1fr;gap:8px 12px;font-size:.85rem;}
.modal-box dt{color:var(--muted);}
.modal-box dd{margin:0;}
.modal-close{float:right;cursor:pointer;color:var(--muted);font-size:1.2rem;}

/* =========================================================
   Help Center
   ========================================================= */
.help-hero{padding:40px 0 10px;text-align:center;}
.help-hero h1{font-size:clamp(1.7rem,3vw,2.3rem);font-weight:800;margin-bottom:10px;}
.help-hero p{color:var(--muted);max-width:560px;margin:0 auto;}
.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:36px 0;}
.help-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;}
.help-card h3{display:flex;align-items:center;gap:10px;font-size:1.05rem;font-weight:800;margin-bottom:14px;}
.help-card ul{display:flex;flex-direction:column;gap:10px;}
.help-card li{display:flex;gap:10px;font-size:.86rem;color:var(--muted);align-items:flex-start;}
.help-card.dont li svg{color:#ff7a90;}
.help-card.do li svg{color:#4ade80;}
@media(max-width:760px){.help-grid{grid-template-columns:1fr;}}

.process-steps{display:flex;flex-direction:column;gap:16px;margin:34px 0;}
.pstep{display:flex;gap:16px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 20px;}
.pstep .num{
  flex:none;width:38px;height:38px;border-radius:50%;background:rgba(224,24,79,.16);color:var(--pink-2);
  display:flex;align-items:center;justify-content:center;font-weight:800;font-family:'Sora',sans-serif;
}
.pstep h4{font-size:.95rem;font-weight:700;margin-bottom:4px;}
.pstep p{font-size:.83rem;color:var(--muted);}


/* =========================================================
   Brand logo chip (partner company mark)
   ========================================================= */
.brand-logo{
  display:inline-flex;align-items:center;gap:9px;
  background:#fff;border-radius:11px;padding:6px 14px 6px 6px;
  box-shadow:0 3px 12px -4px rgba(0,0,0,.35);
}
.brand-logo.lg{padding:9px 18px 9px 9px;gap:11px;}
.bl-mono{
  flex:none;border-radius:8px;color:#fff;font-family:'Sora',sans-serif;
  font-weight:800;display:flex;align-items:center;justify-content:center;
  letter-spacing:.02em;
}
.pcard .bl-mono{width:32px;height:32px;font-size:.62rem;}
.brand-logo.lg .bl-mono{width:44px;height:44px;font-size:.76rem;border-radius:10px;}
.rp .bl-mono{width:30px;height:30px;font-size:.58rem;border-radius:7px;}
.bl-name{color:#14121a;font-weight:700;font-size:.78rem;font-family:'Sora',sans-serif;white-space:nowrap;line-height:1.15;}
.brand-logo.lg .bl-name{font-size:.94rem;}
.bl-name small{display:block;font-weight:600;font-size:.66rem;color:#6b6470;}

/* =========================================================
   Logo image (uploaded CareerNext Academy mark)
   ========================================================= */
.logo .mark{
  width:38px;height:38px;flex:none;border-radius:9px;
  object-fit:cover;background:#fff;padding:2px;
  box-shadow:0 2px 10px -2px rgba(0,0,0,.5);
}

/* =========================================================
   Journey timeline — extra motion (2016 founded / 2017 launched)
   ========================================================= */
.tl-item{position:relative;}
.tl-item .yr{position:relative;}
.tl-item.in .yr{animation:chipPulse 2.6s ease-in-out infinite;animation-delay:calc(var(--d,0s) + .75s);}
@keyframes chipPulse{
  0%,100%{box-shadow:0 0 0 0 rgba(224,24,79,.38);}
  50%{box-shadow:0 0 0 7px rgba(224,24,79,0);}
}
.tl-item .glyph{animation:floatIcon 3.2s ease-in-out infinite;animation-delay:calc(var(--d,0s) + .3s);}
@keyframes floatIcon{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}
.tl-item h4{position:relative;}
.tl-item.tl-today{background:linear-gradient(160deg,rgba(224,24,79,.14),var(--card) 70%);border-color:rgba(224,24,79,.35);}
.tl-item.tl-today .yr{background:linear-gradient(120deg,var(--pink),var(--gold));color:#1a0d10;}

/* =========================================================
   Breadcrumb back link
   ========================================================= */
.back-link{display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:700;color:var(--pink-2);margin-left:auto;}
.back-link:hover{text-decoration:underline;}

/* =========================================================
   Apply Wizard overlay
   ========================================================= */
.wiz-overlay{
  position:fixed;inset:0;z-index:500;background:var(--bg);
  transform:translateY(100%);opacity:0;pointer-events:none;
  transition:transform .55s var(--ease),opacity .5s var(--ease);
  overflow-y:auto;-webkit-overflow-scrolling:touch;
}
.wiz-overlay.open{transform:translateY(0);opacity:1;pointer-events:auto;}
.wiz-topbar{
  position:sticky;top:0;z-index:5;background:rgba(9,6,9,.97);border-bottom:1px solid var(--border);
  padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;
}
.wiz-topbar b{font-family:'Sora',sans-serif;font-size:.95rem;font-weight:700;}
.wiz-topbar span{display:block;font-size:.72rem;color:var(--muted);}
.wiz-close{
  width:38px;height:38px;border-radius:50%;flex:none;
  background:var(--card);border:1px solid var(--border);color:var(--text);
  display:flex;align-items:center;justify-content:center;transition:background .25s var(--ease),transform .25s var(--ease);
}
.wiz-close:hover{background:rgba(224,24,79,.2);transform:rotate(90deg);}

.f-group.invalid input,.f-group.invalid select{border-color:#ff5c7a;background:rgba(255,92,122,.06);}
.f-err{color:#ff7a90;font-size:.76rem;margin-top:6px;display:none;}
.f-err.show{display:block;}

.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:6px;}
@media(max-width:560px){.upload-grid{grid-template-columns:1fr;}}
.upload-box{
  position:relative;border:1.5px dashed var(--border);border-radius:12px;padding:18px 14px;
  text-align:center;cursor:pointer;transition:border-color .25s var(--ease),background .25s var(--ease);
  background:var(--card-2);
}
.upload-box:hover{border-color:var(--pink);background:rgba(224,24,79,.07);}
.upload-box.invalid{border-color:#ff5c7a;}
.upload-box.filled{border-style:solid;border-color:#4ade80;background:rgba(74,222,128,.07);}
.upload-box input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;}
.upload-box svg{color:var(--pink-2);margin-bottom:6px;}
.upload-box .lbl{display:block;font-size:.84rem;font-weight:700;}
.upload-box .sub{display:block;font-size:.72rem;color:var(--muted);margin-top:2px;}
.upload-box .fname{font-size:.76rem;color:#4ade80;font-weight:700;margin-top:6px;word-break:break-all;}
.doc-note{
  display:flex;gap:10px;background:rgba(216,173,77,.1);border:1px solid rgba(216,173,77,.35);
  border-radius:10px;padding:12px 14px;font-size:.8rem;color:var(--muted);margin-bottom:18px;
}
.doc-note svg{flex:none;color:var(--gold);margin-top:1px;}

.pay-opt input[type=radio]{accent-color:var(--pink);width:18px;height:18px;flex:none;}
.pay-opt-left{display:flex;align-items:center;gap:12px;}

.wiz-fee-box{
  background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 20px;margin-bottom:20px;
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;
}
.wiz-fee-box b{font-family:'Sora',sans-serif;font-size:1.4rem;font-weight:800;color:var(--pink-2);}
.wiz-fee-box span{font-size:.78rem;color:var(--muted);}

@media(max-width:640px){
  .wizard-wrap{padding:22px 16px 60px;}
}

/* =========================================================
   Page-load animation
   ========================================================= */
.page-loader{
  position:fixed;inset:0;z-index:9999;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  transition:opacity .5s var(--ease),visibility .5s var(--ease);
}
.page-loader.hide{opacity:0;visibility:hidden;pointer-events:none;}
.page-loader .pl-mark{
  width:56px;height:56px;border-radius:16px;
  background:linear-gradient(135deg,var(--pink),var(--pink-deep));
  display:flex;align-items:center;justify-content:center;color:#fff;
  animation:loaderPulse 1.1s ease-in-out infinite;
  box-shadow:0 14px 34px -10px rgba(224,24,79,.65);
}
.page-loader span{font-family:'Sora',sans-serif;font-weight:700;font-size:.85rem;letter-spacing:.03em;color:var(--muted);opacity:0;animation:dropIn .6s var(--ease) .2s forwards;}
@keyframes loaderPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.12) rotate(-4deg);}}
body.loading{overflow:hidden;}
</style>
</head>
